# Storage & SQLite
DATABASE_URL=sqlite:///./storage/studio.db

# Server Bindings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Default Timezone & Preferences
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_SYNC_POLICY=keep_natural_speed
DEFAULT_SUBTITLE_FONT_SIZE=24
DEFAULT_SUBTITLE_FONT_COLOR=&H00FFFFFF

# Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Instagram Reels Publishing & Webhook Automation
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# YouTube Shorts Direct Upload (Google Cloud OAuth2 Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
